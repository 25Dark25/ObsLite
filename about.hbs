<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>obs-lite third-party licenses</title>
<style>
  body { font-family: sans-serif; max-width: 960px; margin: 2em auto; padding: 0 1em; }
  pre { white-space: pre-wrap; background: #f4f4f4; padding: 1em; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>obs-lite includes the following open source software. Each license applies to the crates listed with it.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li>{{name}} ({{count}})</li>
{{/each}}
</ul>
<h2>Licenses</h2>
{{#each licenses}}
<h3>{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
